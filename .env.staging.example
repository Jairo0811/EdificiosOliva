# Edificios Oliva — inventario de configuración de STAGING (no ejecutable tal cual)
# Todos los valores son sintéticos. Nunca almacenar contraseñas ni tokens aquí.
# Ejecutar: node scripts/validate-staging-config.mjs --template
# En un entorno ya aprovisionado, validar variables INYECTADAS por gestor de secretos:
# node scripts/validate-staging-config.mjs --environment

# Dominio reservado de ejemplo: reemplazar por un hostname de staging autorizado.
AllowedHosts=staging.example.invalid
Cors__AllowedOrigins__0=https://staging.example.invalid
Payments__FrontendReturnUrl=https://staging.example.invalid/reservar
Property__TimeZoneId=America/Santo_Domingo

# SQL Server AISLADO y credenciales desde gestor de secretos, nunca desde Git.
ConnectionStrings__DefaultConnection=REPLACE_WITH_STAGING_CONNECTION_STRING

# Identidad de pruebas, nunca el proyecto Firebase de produccion.
Firebase__ProjectId=edificios-oliva-staging-REPLACE_ME

# Credencial HMAC de estado/checkout: solo se inyecta mediante gestor de secretos.
PublicPayments__ActiveKeyVersion=1
PublicPayments__CapabilityKeys__1=REPLACE_WITH_SECRET_MANAGER_BASE64_256_BIT_KEY

# Proxy interno nginx aprobado por IP exacta; sustituir según la topología validada.
ReverseProxy__KnownProxies__0=

# No habilitar pasarela, ni una URL productiva, antes de la certificacion.
Payments__Azul__Enabled=false
Payments__Azul__MerchantId=
Payments__Azul__AuthKey=
Payments__Azul__PaymentPageUrl=
Payments__Azul__AlternatePaymentPageUrl=
Payments__Azul__ReturnBaseUrl=

# No enviar correos hasta disponer de SMTP de pruebas y destinatarios controlados.
Notifications__Email__Enabled=false
Notifications__Email__Host=
Notifications__Email__Username=
Notifications__Email__Password=
Notifications__Email__PublicBaseUrl=https://staging.example.invalid

# Sin TLS extremo a extremo solamente cuando un proxy CONFIABLE termina HTTPS.
# Por defecto exigir HTTPS directamente; ajustar durante la preparación de infraestructura.
Security__UseHttpsRedirection=true
